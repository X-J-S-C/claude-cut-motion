{
  "name": "claude-cut-motion",
  "version": "1.0.0",
  "private": true,
  "description": "A 30-second hand-drawn-style mock of a Chinese desktop video editor, rebuilt as a deterministic Remotion composition.",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts ClaudeCutMotion out/stills/t00.00.png --frame=0",
    "render": "remotion render src/index.ts ClaudeCutMotion out/master.mp4",
    "render:swangle": "remotion render src/index.ts ClaudeCutMotion out/master.mp4 --gl=swangle",
    "render:fallback": "node scripts/render.cjs --sandbox",
    "bundle-check": "node scripts/bundle-check.cjs",
    "typecheck": "tsc --noEmit",
    "encode": "node scripts/encode-frames.cjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
